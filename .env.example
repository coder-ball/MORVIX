MORVIX_DATABASE=./data/morvix.db
MORVIX_TEXT_MODELS=MoritzLaurer/deberta-v3-base-zeroshot-v2.0,KoalaAI/Text-Moderation,sentinet/suicidality,unitary/toxic-bert
MORVIX_VIOLENCE_MODEL=jaranohaal/vit-base-violence-detection
MORVIX_IMAGE_MODEL=openai/clip-vit-base-patch32
MORVIX_TEXT_THRESHOLD=0.80
MORVIX_IMAGE_THRESHOLD=0.65
MORVIX_MAX_UPLOAD_MB=12
MORVIX_LOCAL_ONLY=1
MORVIX_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

MORVIX_GOOGLE_CLIENT_ID=
MORVIX_TEXT_ML=1
MORVIX_AUDIO_MODEL=tiny
MORVIX_IMAGE_ML=1

# Email verification codes for new parent accounts (FR-AUTH-09). Gmail: turn on 2-Step Verification,
# then create an App Password (Google Account > Security > App passwords) and paste it below.
MORVIX_EMAIL_MODE=smtp
MORVIX_SMTP_HOST=smtp.gmail.com
MORVIX_SMTP_PORT=587
MORVIX_SMTP_USER=
MORVIX_SMTP_PASSWORD=
MORVIX_SMTP_FROM=
