{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MORVIX: Start backend",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "uvicorn", "backend.main:app", "--env-file", ".env", "--host", "127.0.0.1", "--port", "8000"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "MORVIX: Start dashboard server",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "http.server", "5500", "--bind", "127.0.0.1"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
