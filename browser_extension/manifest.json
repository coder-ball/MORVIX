{
  "manifest_version": 3,
  "name": "MORVIX Content Protection",
  "version": "3.7.3",
  "description": "Local-first protection for page text, images and video. Reports detections to the parent dashboard.",
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*", "http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "MORVIX", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start"}]
}
